---
import '../styles/global.css';
import { BiprompterApp } from '../components/BiprompterApp';
---

<!doctype html>
<html lang="tr" class="dark bg-transparent h-full w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Biprompter - Profesyonel Masaüstü Teleprompter</title>
    <meta name="description" content="Akıcı kaydırma, ayna modu ve yerel çalışma gücüyle yeni nesil teleprompter." />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-transparent text-[#EDEDED] m-0 p-0 antialiased select-none h-full w-full overflow-hidden">
    <BiprompterApp client:only="react" />
  </body>
</html>
