{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Biprompter",
  "version": "1.0.0",
  "identifier": "com.biprompter.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Biprompter",
        "width": 1200,
        "height": 800,
        "minWidth": 40,
        "minHeight": 24,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
